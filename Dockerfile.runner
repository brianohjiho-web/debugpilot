# The sandbox: every language toolchain, no internet, non-root.
FROM golang:1.22-bookworm AS go

FROM python:3.12-slim-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc g++ libc6-dev nodejs openjdk-17-jdk-headless r-base-core \
 && rm -rf /var/lib/apt/lists/*
COPY --from=go /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH \
    GW_GOCACHE=/tmp/gocache \
    PYTHONDONTWRITEBYTECODE=1
RUN pip install --no-cache-dir "fastapi>=0.110" "uvicorn>=0.29" "pydantic>=2"
RUN useradd --create-home --shell /usr/sbin/nologin runner
WORKDIR /app
COPY runner /app/runner
USER runner
EXPOSE 8001
CMD ["uvicorn", "runner.app:app", "--host", "0.0.0.0", "--port", "8001"]
