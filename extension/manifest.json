{
  "manifest_version": 3,
  "name": "DebugPilot",
  "version": "1.0.0",
  "description": "Scan the page you're on for crashes and speed problems, with fixes proven in the live page.",
  "action": {
    "default_title": "Scan this page with DebugPilot",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "storage", "contextMenus"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
